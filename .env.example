# ===== Supabase =====
# 在 Supabase 控制台 → Project Settings → API 获取
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 仅服务端使用，切勿暴露给前端

# ===== 腾讯位置服务 =====
# JSAPI 底图 + WebService(travel_guide/poi_search) 共用同一个 Key
# 申请：https://lbs.qq.com  → 控制台 → 创建应用 → 勾选 JavaScriptAPI 与 WebServiceAPI
TMAP_KEY=your-tencent-key
VITE_TMAP_KEY=your-tencent-key

# ===== 12306 票价兜底 =====
# base-table = 用城市经纬度距离 × 高铁单价估算（默认）
# 后续可改为 12306 官方查价接口
RAILWAY_FARE_SOURCE=base-table
