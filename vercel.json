{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/" }],
  "functions": {
    "api/plan.ts": { "maxDuration": 60, "regions": ["hnd1"] },
    "api/trains.ts": { "maxDuration": 30, "regions": ["hnd1"] },
    "api/flights.ts": { "maxDuration": 30, "regions": ["hnd1"] },
    "api/auth/callback.ts": { "maxDuration": 30, "regions": ["hnd1"] }
  }
}
